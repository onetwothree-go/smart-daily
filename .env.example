# ============================================================
#  智能日报生成器 —— 凭证配置模板
#
#  用法：
#   1. 把本文件复制为 .env（同一目录）
#   2. 在 .env 里填入真实值
#   3. .gitignore 里加上 .env（绝不能提交！）
#   4. 代码里用 python-dotenv 读取，或用 uv run --env-file .env xxx
#
#  ⚠️ 铁律：这三个凭证一律走环境变量，严禁写入代码或提交到仓库
#     指导书把「安全配置」划为红色等级——AI 给的一律不能直接用
# ============================================================

# ---------- GitHub 个人访问令牌（只勾只读权限） ----------
# 申请：https://github.com/settings/personal-access-tokens/new
# 类型：Fine-grained token（细粒度），限定到「小组的那一个仓库」
# 权限：Contents → Read-only（只读），其余一律不勾
# 有效期建议 30 天，课程结束就吊销
# ⚠️ 不要用 Classic token —— 粒度太粗，会波及你所有仓库
GITHUB_TOKEN=

# 小组仓库地址（配置管理员填）
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=

# ---------- 飞书开放平台自建应用 ----------
# 申请：https://open.feishu.cn/app → 创建企业自建应用
#
# 需要的权限（与 src/smart_daily/collectors/feishu.py 实际调用的 API 一一对应）：
#   im:message          读消息      → /im/v1/messages
#   im:chat             读群信息    → /im/v1/chats
#   task:task           读任务      → /task/v1/tasks
#   contact:user.base   读用户信息  → /contact/v3/users
#
# ⚠️ 开通后必须到「版本管理与发布」发布新版本，权限才生效
# ⚠️ 还要到「应用可用范围」把全部组员加进来，否则只能读到你自己的数据
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 群聊 ID（采集群消息用，可留空 —— 留空则自动从机器人所在群里发现）
# 获取：群设置 → 群信息 → 群 ID（形如 oc_xxxxxxxxxx）
FEISHU_CHAT_ID=

# 群机器人 Webhook（用于推送团队日报）
# 获取：群设置 → 添加机器人 → 自定义机器人 → 复制 Webhook 地址
FEISHU_WEBHOOK_URL=

# 机器人「安全设置」里的签名密钥（勾选「签名校验」后自动生成）
# 留空 = 机器人未开启签名校验；填了则推送请求自动带 timestamp + sign
FEISHU_WEBHOOK_SECRET=

# ---------- SMTP 邮件推送 ----------
# 用个人邮箱开通即可：
#   QQ邮箱：设置 → 账户 → 开启 SMTP 服务 → 获取授权码
#   163邮箱：设置 → POP3/SMTP → 开启 → 获取授权码
# 注意：这里填的是「授权码」，不是登录密码
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# 团队日报收件人（逗号分隔）
REPORT_RECIPIENTS=

# 成员 -> 邮箱映射（个人日报按人分别发送，格式：成员:邮箱,成员:邮箱）
# 成员名要和采集到的 author_name 一致；一个成员多个邮箱用分号隔开
# 例：MEMBER_EMAILS=张三:zhangsan@qq.com,李四:lisi@163.com;lisi_alt@163.com
MEMBER_EMAILS=

# ---------- 本地配置（非机密） ----------
# 日报统计的自然日截止时间（如 18:00）
DAILY_CUTOFF=18:00
# SQLite 数据库文件路径
DB_PATH=data/daily_report.db
